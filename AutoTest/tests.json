{
  "exercise": "Nospresso",
  "version": "2.0",
  "scenarios": [

    {
      "name": "machine_selection_out_of_range_low",
      "description": "L'utilisateur saisit un ID de machine négatif.",
      "score": 0.5,
      "commands": [
        { "input": "-1", "delay_seconds": 0.3 }
      ],
      "require": [
        { "type": "regex", "value": ".*Machine.*invalide.*" }
      ],
      "forbid": []
    },
    {
      "name": "machine_selection_out_of_range_high",
      "description": "L'utilisateur saisit un ID hors limite supérieure.",
      "score": 0.5,
      "commands": [
        { "input": "99", "delay_seconds": 0.3 }
      ],
      "require": [
        { "type": "regex", "value": ".*Machine.*invalide.*" }
      ],
      "forbid": []
    },
    {
      "name": "machine_selection_not_number",
      "description": "L'utilisateur saisit autre chose qu'un nombre.",
      "score": 0.5,
      "commands": [
        { "input": "abc", "delay_seconds": 0.3 }
      ],
      "require": [
        { "type": "regex", "value": ".*invalide.*" }
      ],
      "forbid": []
    },
    {
      "name": "pin_success",
      "description": "Code PIN correct du premier coup.",
      "score": 1.0,
      "commands": [
        { "input": "2", "delay_seconds": 0.3 },
        { "input": "434343", "delay_seconds": 0.3 }
      ],
      "require": [
        { "type": "regex", "value": ".*Accès.*accordé.*" }
      ],
      "forbid": []
    },
    {
      "name": "pin_fail_three_times_various_lengths",
      "description": "3 échecs avec des PIN de mauvaise taille.",
      "score": 1.0,
      "commands": [
        { "input": "1", "delay_seconds": 0.3 },
        { "input": "1", "delay_seconds": 0.3 },
        { "input": "12345", "delay_seconds": 0.3 },
        { "input": "1234567", "delay_seconds": 0.3 }
      ],
      "require": [
        { "type": "regex", "value": ".*Code.*PIN.*incorrect.*" },
        { "type": "regex", "value": ".*Trop.*de.*tentatives.*" }
      ],
      "forbid": [
        { "type": "regex", "value": ".*Accès.*accordé.*" }
      ]
    },
    {
      "name": "pin_non_numeric",
      "description": "Saisie d'un PIN contenant des lettres.",
      "score": 0.5,
      "commands": [
        { "input": "3", "delay_seconds": 0.2 },
        { "input": "abcd12", "delay_seconds": 0.2 },
        { "input": "------", "delay_seconds": 0.2 },
        { "input": "123abc", "delay_seconds": 0.2 }
      ],
      "require": [
        { "type": "regex", "value": ".*incorrect.*" }
      ],
      "forbid": []
    },
    {
      "name": "update_pin_success",
      "description": "Mise à jour PIN correcte.",
      "score": 1.0,
      "commands": [
        { "input": "4", "delay_seconds": 0.3 },
        { "input": "434343", "delay_seconds": 0.3 },
        { "input": "777777", "delay_seconds": 0.3 }
      ],
      "require": [
        { "type": "regex", "value": ".*nouveau.*code.*PIN.*" },
        { "type": "regex", "value": ".*mis.*à.*jour.*" }
      ],
      "forbid": []
    },
    {
      "name": "update_pin_repeated_invalid",
      "description": "L'utilisateur donne plusieurs PIN invalides avant réussite.",
      "score": 1.0,
      "commands": [
        { "input": "2", "delay_seconds": 0.2 },
        { "input": "434343", "delay_seconds": 0.2 },
        { "input": "12", "delay_seconds": 0.2 },
        { "input": "12345", "delay_seconds": 0.2 },
        { "input": "abcdef", "delay_seconds": 0.2 },
        { "input": "999999", "delay_seconds": 0.2 }
      ],
      "require": [
        { "type": "regex", "value": ".*6 chiffres.*" },
        { "type": "regex", "value": ".*mis.*à.*jour.*" }
      ],
      "forbid": []
    },
    {
      "name": "update_pin_invalid_characters",
      "description": "PIN contenant des caractères spéciaux.",
      "score": 0.7,
      "commands": [
        { "input": "1", "delay_seconds": 0.3 },
        { "input": "434343", "delay_seconds": 0.3 },
        { "input": "12-34!", "delay_seconds": 0.3 }
      ],
      "require": [
        { "type": "regex", "value": ".*incorrect.*" }
      ],
      "forbid": [
        { "type": "regex", "value": ".*mis.*à.*jour.*" }
      ]
    },
    {
      "name": "restock_success",
      "description": "Réapprovisionnement correct.",
      "score": 1.0,
      "commands": [
        { "input": "3", "delay_seconds": 0.3 },
        { "input": "434343", "delay_seconds": 0.3 },
        { "input": "100", "delay_seconds": 0.3 },
        { "input": "50", "delay_seconds": 0.3 },
        { "input": "30", "delay_seconds": 0.3 }
      ],
      "require": [
        { "type": "regex", "value": ".*stocks.*mis.*à.*jour.*" }
      ],
      "forbid": []
    },
    {
      "name": "restock_negative_values",
      "description": "L'administrateur saisit des valeurs négatives.",
      "score": 1.0,
      "commands": [
        { "input": "1", "delay_seconds": 0.3 },
        { "input": "434343", "delay_seconds": 0.3 },
        { "input": "-10", "delay_seconds": 0.3 },
        { "input": "-50", "delay_seconds": 0.3 },
        { "input": "-1", "delay_seconds": 0.3 }
      ],
      "require": [
        { "type": "regex", "value": ".*valeur.*positive.*" }
      ],
      "forbid": [
        { "type": "regex", "value": ".*mis.*à.*jour.*succès.*" }
      ]
    },
    {
      "name": "restock_huge_values",
      "description": "Saisie de quantités énormes (stress test).",
      "score": 0.8,
      "commands": [
        { "input": "1", "delay_seconds": 0.3 },
        { "input": "434343", "delay_seconds": 0.3 },
        { "input": "999999", "delay_seconds": 0.3 },
        { "input": "999999", "delay_seconds": 0.3 },
        { "input": "999999", "delay_seconds": 0.3 }
      ],
      "require": [
        { "type": "regex", "value": ".*stocks.*mis.*à.*jour.*" }
      ],
      "forbid": []
    },

    {
      "name": "serve_client_success",
      "description": "Le client commande une boisson avec suffisamment de stock.",
      "score": 1.0,
      "commands": [
        { "input": "2", "delay_seconds": 0.3 },
        { "input": "1", "delay_seconds": 0.3 } 
      ],
      "require": [
        { "type": "regex", "value": ".*Boisson.*préparée.*" }
      ],
      "forbid": []
    },
    {
      "name": "serve_client_insufficient_stock",
      "description": "Stock insuffisant pour préparer une boisson.",
      "score": 1.0,
      "commands": [
        { "input": "4", "delay_seconds": 0.3 },
        { "input": "1", "delay_seconds": 0.3 }
      ],
      "require": [
        { "type": "regex", "value": ".*Stock.*insuffisant.*" },
        { "type": "regex", "value": ".*sélectionner.*une.*autre.*machine.*" }
      ],
      "forbid": [
        { "type": "regex", "value": ".*Boisson.*préparée.*" }
      ]
    },
    {
      "name": "serve_client_invalid_choice",
      "description": "Le client choisit une boisson inexistante.",
      "score": 0.7,
      "commands": [
        { "input": "3", "delay_seconds": 0.3 },
        { "input": "999", "delay_seconds": 0.3 }
      ],
      "require": [
        { "type": "regex", "value": ".*choix.*invalide.*" }
      ],
      "forbid": []
    }

  ]
}
